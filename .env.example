# ==============================================================================
# PRAXEON Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cognitive Supervision (Runtime Decision & Safety)
# ------------------------------------------------------------------------------
# Clave de API de TypeSafe AI (modelo Jev / System One).
# Si usas LAYA localmente (pip install laya), no necesitas clave remota.
TYPESAFE_API_KEY=tu_typesafe_api_key_aqui

# ------------------------------------------------------------------------------
# 2. Autonomous Agent LLM (Generación de Acciones)
# PRAXEON detecta automáticamente la mejor opción disponible en este orden:
# ------------------------------------------------------------------------------

# Opción A (Recomendada Nube - Gratuita y Rápida): Groq Cloud
# 14.400 peticiones/día y 30 RPM gratuitas. Modelos: llama-3.3-70b-versatile, qwen-2.5-coder-32b
GROQ_API_KEY=tu_groq_api_key_aqui

# Opción B (Recomendada Local - 100% Offline, Sin Límites, Cero Coste): Ollama
# PRAXEON detecta si Ollama está corriendo en localhost:11434 automáticamente.
# Modelos sugeridos: qwen2.5-coder:7b, llama3.2:3b, mistral:7b
# OLLAMA_HOST=http://localhost:11434/v1

# Opción C (Nube Multimodelo): OpenRouter
# Acceso a modelos gratuitos (:free) como qwen/qwen-2.5-coder-32b-instruct:free
# OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Opción D (Local): LM Studio
# LMSTUDIO_HOST=http://localhost:1234/v1

# Opción E: Google Gemini (Opcional)
# GEMINI_API_KEY=tu_gemini_api_key_aqui

# Opción F: OpenAI estándar u otro endpoint compatible
# OPENAI_API_KEY=tu_openai_api_key_aqui

